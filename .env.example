# Don Carlos Rewards — environment variables (BLUEPRINT.md §10.1).
# Copy to `.env.local` and fill in values. NEVER commit real secrets.
# `src/lib/env.ts` validates these with Zod and fails fast if any required
# value is missing or malformed.

# ---- Supabase (Phase 2/3) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC. Used by trusted server code for
# admin operations that bypass RLS. Must never be imported into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# http://localhost:3000 in dev · the deployed URL in preview/prod
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Maps (Phase 8) ----
# Keyless Google Maps Embed iframe src, or a referrer-restricted key.
NEXT_PUBLIC_MAPS_EMBED=

# ---- Rate limiting (Phase 10) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Monitoring (Phase 12, optional) ----
SENTRY_DSN=
